#include<iostream>
using namespace std;
int main()
{ int n;
    cout<<"Enter number of array elements:";
    cin>>n;
    int a[n];
    cout<<"Enter the array elements:";
    for(int i=0;i<n;i++)
    {
        cin>>a[i];
    }
    int target;
    cout<<"Enter target element:";
    cin>>target;
    int low=0, high=n-1;
    while(low<=high)
    {
        int mid=(low+high)/2;
        if(a[mid]==target)
        {
            cout<<"Element found at index"<<mid;
            return 0;
        }
        if(a[low]<=a[mid])
        {
            if(target>=a[low] && target<a[mid]){
                high=mid-1;}
            else{
                low=mid+1;}
        }
        else
        {
            if(target>a[mid] && target<=a[high])
              {  low=mid+1;}
            else
              {  high=mid-1;}
        }
    }
    cout<<-1;
    return 0;
}
