#include <iostream>
#include <algorithm>
using namespace std;

int main()
{
	int n;

	cout << "Enter number of stairs: ";
	cin >> n;

	int cost[10];
	int dp[10];

	cout << "Enter cost of each stair: ";
	for (int i = 0; i < n; i++)
	{
		cin >> cost[i];
	}

	// Base cases
	dp[0] = cost[0];   // Start from stair zero
	dp[1] = cost[1];   //Start from stair one

	// DP calculation
	for (int i = 2; i < n; i++)
	{
		dp[i] = cost[i] + min(dp[i - 1], dp[i - 2]);
	}

	// Minimum cost to reach the top
	int answer = min(dp[n - 1], dp[n - 2]);

	cout << "Minimum cost = " << answer << endl;

	return 0;
}
