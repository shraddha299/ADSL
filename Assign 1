#include <iostream>
using namespace std;

int main()
{
    int n, a[100];

    cout << "Enter number of elements: ";
    cin >> n;

    cout << "Enter array elements (1's followed by 0's): ";
    for(int i = 0; i < n; i++)
    {
        cin >> a[i];
    }

    int low = 0, high = n - 1, firstzero = -1;

    while(low <= high)           
    {
        int mid = (low + high) / 2;    //Calculate mid value

        if(a[mid] == 0)             // check if mid element is 0
        {
            firstzero = mid;         // store index of first zero
            high = mid - 1;          // moves to left to find first zero 
        }
        else
        {
            low = mid + 1;          // moves to right if zero is not found
        }
    }

    if(firstzero == -1)             // if zero not found in array
        cout << "Number of zeroes = 0";
    else
        cout << "Number of zeroes = " << n - firstzero;       // calculate no. of zero by substracting the total element by index of first zero

    return 0;
}
