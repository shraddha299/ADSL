#include <iostream>
using namespace std;

int coins[20];
int n, sum;

void printWays(int remaining, int start, int selected[], int index)
{
    if (remaining == 0)
    {
        for (int i = 0; i < index; i++)
        {
            cout << selected[i] << " ";
        }
        cout << endl;
        return;
    }

    for (int i = start; i < n; i++)
    {
        if (coins[i] <= remaining)
        {
            selected[index] = coins[i];

            printWays(remaining - coins[i], i, selected, index + 1);
        }
    }
}

int main()
{
    cout << "Enter number of coins: ";
    cin >> n;

    cout << "Enter coin values: ";
    for (int i = 0; i < n; i++)
    {
        cin >> coins[i];
    }

    cout << "Enter sum: ";
    cin >> sum;

    int nw[10] = {0};

    nw[0] = 1;

    for (int i = 0; i < n; i++)
    {
        for (int j = coins[i]; j <= sum; j++)
        {
            nw[j] = nw[j] + nw[j - coins[i]];
        }
    }

    cout << "\nNumber of ways = " << nw[sum] << endl;

    cout << "\nWays are:\n";

    int selected[10];

    printWays(sum, 0, selected, 0);

    return 0;
}
