#include <iostream>
using namespace std;

int main() {
    int n;

    cout << "Enter number of houses: ";
    cin >> n;

    int nums[n];
    cout << "Enter money in each house: ";

    for (int i = 0; i < n; i++) {
        cin >> nums[i];
    }

    // Handle special cases
    if (n == 1) {
        cout << "Maximum money: " << nums[0];
        return 0;
    }

    int dp[n];

    dp[0] = nums[0];
    dp[1] = max(nums[0], nums[1]);

    for (int i = 2; i < n; i++) {
        dp[i] = max(dp[i - 1], dp[i - 2] + nums[i]);
    }

    cout << "Maximum money that can be robbed: " << dp[n - 1];

    return 0;
}
