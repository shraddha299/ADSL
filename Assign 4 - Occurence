#include<iostream>
using namespace std;

int first(int a[],int n,int x)
{
    int low=0,high=n-1,ans=-1;
    
    while(low<=high)
    {
        int mid=(low+high)/2;
        if(a[mid]==x)
        {
            ans=mid;
            high=mid-1;
        }
        else if(a[mid]<x)
        {
            low=mid+1;
        }
        else
        {
            high=mid-1;
        }
    }
    return ans;
}

int last(int a[],int n,int x)
{
    int low=0, high=n-1, ans=-1;
    while(low<=high)
    {
        int mid=(low+high)/2;
        if(a[mid]==x)
        {
            ans=mid;
            low=mid+1;
        }
        else if(a[mid]<x)
        {
            low=mid+1;
        }
        else
        {
            high=mid-1;
        }
    }
    return ans;
}

int main()
{
    int n;
    cout<<"Enter number of elements: ";
    cin>>n;
    int a[n];
    
    cout<<"Enter sorted array elements: ";
    for(int i=0;i<n;i++)
    {
        cin>>a[i];
    }
        
    int x;
    cout<<"Enter target element: ";
    cin>>x;
    
    int f=-1,l=-1;
    
    f=first(a,n,x);
    l=last(a,n,x);
    
      if(f==-1 && l==-1)
    { 
        cout<<0;
        return 0;
    }
    
    cout<<"Occurrences = "<<l-f+1;
    return 0;
}
