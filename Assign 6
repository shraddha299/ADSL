#include <iostream>
using namespace std;

int main() 
{
    int n;

    cout << "Enter number of days: ";
    cin >> n;

    int price[100];

    cout << "Enter stock prices:\n";
    for (int i = 0; i < n; i++) 
    {
        cin >> price[i];
    }

    int maxPrice = price[n - 1];
    int profit = 0;

    for (int i = n - 2; i >= 0; i--) 
    {

        if (price[i] > maxPrice)     
        {
            maxPrice = price[i];
        } 
        else 
        {
            profit = profit + (maxPrice - price[i]);     
        }
    }

    cout << "Maximum Profit is: " << profit << endl;

    return 0;
}
