#include <iostream>
using namespace std;

int main()
{
    int n, sum;

    cout << "Enter number of elements: ";
    cin >> n;

    int a[n];

    cout << "Enter array elements: ";
    for (int i = 0; i < n; i++)
    {
        cin >> a[i];
    }

    cout << "Enter target sum: ";
    cin >> sum;

    bool dp[sum + 1] = {false};

    // Sum 0 is always possible
    dp[0] = true;

    for (int i = 0; i < n; i++)
    {
        for (int j = sum; j >= a[i]; j--)
        {
            if (dp[j - a[i]])
            {
                dp[j] = true;
            }
        }
    }

    if (dp[sum])
        cout << "Subset with given sum exists";
    else
        cout << "Subset with given sum does not exist";

    return 0;
}
